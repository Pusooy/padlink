<Page
    x:Class="PadLink.App.Views.ClientsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="28,12,28,24">
        <StackPanel Spacing="16" MaxWidth="920" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="客户端与设置" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="手机端连接方式、启动行为与产物位置。"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 客户端 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="客户端" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="网页 PWA（推荐，零安装）"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="手机浏览器打开下方地址，iPhone 可「添加到主屏幕」获得全屏 App 体验"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Vm.Url, Mode=OneWay}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       IsTextSelectionEnabled="True"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <FontIcon Glyph="&#xE8EA;" FontSize="18"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="安卓 App（原生）"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="支持振幅级仿生震动、横屏沉浸。APK 由 CI 编译产出"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="产物：Downloads\sidestore-setup\PadLink.apk"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 启动设置 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="启动行为" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="开机自动启动"/>
                            <TextBlock Text="登录 Windows 后自动运行 PadLink"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="AutoStartToggle"
                                      OnContent="开" OffContent="关"
                                      Toggled="AutoStart_Toggled"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="启动时最小化到托盘"/>
                            <TextBlock Text="不弹出主窗口，仅托盘常驻"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="StartMinToggle"
                                      OnContent="开" OffContent="关"
                                      Toggled="StartMin_Toggled"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="启动时打开控制页"/>
                            <TextBlock Text="自动在浏览器中打开手机端控制页"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" x:Name="AutoOpenToggle"
                                      OnContent="开" OffContent="关"
                                      Toggled="AutoOpen_Toggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        PadLink 2.0 · WinUI 3 (Windows App SDK) · .NET 8<LineBreak/>
                        架构：Core（配置/日志）+ Interop（Win32/服务）+ App.WinUI（界面）+ Launcher（单文件）
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
