<Page
    x:Class="PadLink.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="28,12,28,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="应用管理" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="手机端「应用」页会自动列出开始菜单中的所有程序；这里可补充自定义启动项，也可删除不需要的条目。"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="名称（手机显示）"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="启动命令 / 路径 / URI"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Margin="8,0,0,0"/>
                </Grid>

                <ListView Grid.Row="1" x:Name="AppsList"
                          ItemsSource="{x:Bind Vm.Apps, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:AppEntryModel"
                                      xmlns:core="using:PadLink.Core">
                            <Grid Margin="0,3" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="26" Height="26"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE82D;" FontSize="12"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>

                                <TextBox Grid.Column="1"
                                         Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="名称，如 微信"/>
                                <TextBox Grid.Column="2"
                                         Text="{x:Bind Cmd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="notepad.exe 或 C:\...\app.exe"/>

                                <Button Grid.Column="3" Width="36" Height="32"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="DeleteRow_Click"
                                        ToolTipService.ToolTip="删除此条">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="AddRow_Click" Margin="0,0,8,0"
                    Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="添加应用"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Click="Save_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                    <TextBlock Text="保存"/>
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="2" x:Name="CountLabel" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Margin="8,0,0,0"/>
            <Button Grid.Column="3" Click="Reload_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock Text="重新载入"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
