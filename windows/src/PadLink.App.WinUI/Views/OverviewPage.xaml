<Page
    x:Class="PadLink.App.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PadLink.App.Views"
    Background="Transparent">

    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ContentRoot" ColumnSpacing="16" RowSpacing="16"
              Margin="32,16,32,24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PrimaryColumn" Width="5*"/>
                <ColumnDefinition x:Name="SecondaryColumn" Width="3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="HeroRow" Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= 页头 ================= -->
            <StackPanel x:Name="PageHeader" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                <TextBlock Text="概览" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="本机服务状态与手机连接入口。"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- ================= 连接卡片（主角） ================= -->
            <Border x:Name="HeroCard" Grid.Row="1" Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 状态徽标 -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="12" Padding="10,4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{x:Bind Vm.StatusBrush, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 地址 + 二维码 -->
                    <Grid x:Name="HeroContentGrid" Grid.Row="1" ColumnSpacing="24" RowSpacing="16"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="连接地址"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="UrlText"
                                       Text="{x:Bind Vm.Url, Mode=OneWay}"
                                       FontSize="34" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       IsTextSelectionEnabled="True"
                                       Margin="0,2,0,2"/>
                            <TextBlock Text="{x:Bind Vm.IpLine, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       IsTextSelectionEnabled="True"/>
                            <TextBlock Text="手机与电脑处于同一 WiFi，用浏览器或 App 打开上面的地址即可操控。"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>

                            <!-- 三步上手（与二维码就近放置） -->
                            <StackPanel Spacing="8" Margin="0,16,0,0">
                                <Grid ColumnSpacing="10" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="1" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="手机与电脑连到同一个 WiFi 或热点。"/>

                                    <Border Grid.Row="1" Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="2" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="扫描二维码，或输入连接地址。"/>

                                    <Border Grid.Row="2" Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="3" FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="iPhone 可「添加到主屏幕」，获得全屏体验。"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- 二维码：固定深码浅底，任何主题下都能扫 -->
                        <StackPanel x:Name="QrPanel" Grid.Column="1" Grid.RowSpan="2" Spacing="8"
                                    Width="184" VerticalAlignment="Center">
                            <Border Background="#FFFFFFFF"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10">
                                <Image x:Name="QrImageControl" Width="162" Height="162"
                                       Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="手机扫码连接"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 操作区 -->
                    <StackPanel Grid.Row="2" Spacing="12">
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Command="{x:Bind Vm.OpenControlPageCommand}"
                                        Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71B;" FontSize="14"/>
                                        <TextBlock Text="打开控制页"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind Vm.CopyUrlCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                        <TextBlock Text="复制地址"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="关闭窗口后服务继续在托盘运行"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 右栏：实时状态 + 客户端 ================= -->
            <Grid x:Name="RightRail" Grid.Row="1" Grid.Column="1"
                  RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 实时状态：紧凑键值行 -->
                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="实时状态" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="设备连接"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{x:Bind Vm.StatusBrush, Mode=OneWay}"/>
                                <TextBlock Text="{x:Bind Vm.ConnectedCountText, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="监听端口"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Vm.PortText, Mode=OneWay}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       IsTextSelectionEnabled="True"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="局域网 IP"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind Vm.LocalIp, Mode=OneWay}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       IsTextSelectionEnabled="True"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 客户端 -->
                <Border Grid.Row="1" VerticalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="客户端" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,0,0,14"/>

                        <StackPanel Grid.Row="1" Spacing="14" VerticalAlignment="Top">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="White"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="网页 PWA · 零安装"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Text="浏览器打开地址即可使用，iPhone 支持添加到主屏幕。"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="15"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="安卓 App · 原生"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Text="支持仿生震动与横屏沉浸，由 CI 编译产出 APK。"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="15"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="局域网直连"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Text="数据不经云端，手机与电脑点对点通信。"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="2" Padding="0,12,0,0" Margin="0,14,0,0"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="PadLink 2.0 · WinUI 3 · 关闭窗口后驻留托盘"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= 手机端能力（流式布局） ================= -->
            <Border x:Name="CapabilitiesCard" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="手机端可用能力" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <ItemsRepeater ItemsSource="{x:Bind Capabilities}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="CapabilityList"
                                               MinItemWidth="248"
                                               MinRowSpacing="12"
                                               MinColumnSpacing="12"
                                               ItemsJustification="Start"
                                               ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="views:CapabilityItem">
                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="8" Padding="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="8"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="15"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Description}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
