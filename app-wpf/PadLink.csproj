<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PadLink</RootNamespace>
    <AssemblyName>PadLink</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- 全部前端资源嵌入 exe，运行时从程序集读取 —— 保证「纯单文件」分发 -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="web.index.html" />
    <EmbeddedResource Include="wwwroot\manifest.json" LogicalName="web.manifest.json" />
    <EmbeddedResource Include="wwwroot\icon.png" LogicalName="web.icon.png" />
    <EmbeddedResource Include="wwwroot\lucide.min.js" LogicalName="web.lucide.min.js" />
  </ItemGroup>

</Project>
